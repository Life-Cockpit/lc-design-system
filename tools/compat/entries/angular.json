{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false, "cache": { "enabled": false } },
  "newProjectRoot": "projects",
  "projects": {
    "entries": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/entries",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "outputMode": "static",
            "tsConfig": "tsconfig.json",
            "budgets": []
          },
          "configurations": {
            "production": { "outputHashing": "all", "optimization": true, "sourceMap": false, "extractLicenses": false },
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true },
            "no-mermaid": {
              "fileReplacements": [{ "replace": "src/app/reports.ts", "with": "src/app/reports.no-mermaid.ts" }]
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
