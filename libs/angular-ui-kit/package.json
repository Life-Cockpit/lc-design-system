{
  "name": "@lifecorner/angular-ui-kit",
  "version": "3.6.0",
  "description": "LifeCorner Design System – Angular UI component library",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/getlifecorner/lc-design-system.git"
  },
  "keywords": ["angular", "design-system", "angular-ui-kit", "components", "lifecorner"],
  "peerDependencies": {
    "@angular/cdk": "^21.0.0 || ^22.0.0",
    "@angular/common": "^21.0.0 || ^22.0.0",
    "@angular/core": "^21.0.0 || ^22.0.0",
    "@angular/forms": "^21.0.0 || ^22.0.0",
    "@angular/platform-browser": "^21.0.0 || ^22.0.0",
    "@angular/router": "^21.0.0 || ^22.0.0",
    "mermaid": "^11.0.0",
    "rxjs": "^7.8.0"
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    }
  },
  "sideEffects": ["**/*.css", "**/*.scss"],
  "exports": {
    ".": {
      "types": "./types/lifecorner-angular-ui-kit.d.ts",
      "default": "./fesm2022/lifecorner-angular-ui-kit.mjs"
    },
    "./styles": {
      "sass": "./src/styles/index.scss",
      "default": "./src/styles/index.scss"
    },
    "./styles/*": {
      "default": "./src/styles/*"
    },
    "./icon-names.json": {
      "default": "./src/assets/icon-names.json"
    },
    "./package.json": {
      "default": "./package.json"
    }
  }
}
