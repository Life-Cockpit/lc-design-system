{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npx nx run angular-ui-kit:test *)",
      "Bash(npx nx run angular-ui-kit:lint *)",
      "Bash(npx nx run angular-ui-kit:build *)",
      "Bash(npx nx run angular-ui-kit:build-storybook *)",
      "Bash(npx nx run angular-ui-kit:build:tokens *)",
      "Bash(npm run test:tools)",
      "Bash(npm run build:tokens)",
      "Bash(node tools/agents/story-shots.mjs *)",
      "Bash(node tools/compat/check-angular-majors.mjs *)",
      "Bash(npm pack --dry-run dist/libs/angular-ui-kit)",
      "Bash(npm view @lifecorner/angular-ui-kit*)",
      "Bash(npm stage list @lifecorner/angular-ui-kit)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git tag --sort=*)",
      "Bash(git fetch origin *)",
      "Bash(git fetch --tags origin)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rebase main)",
      "Bash(git merge --ff-only *)",
      "Bash(git push origin main)",
      "Bash(gh workflow run publish-npm.yml --ref main -f version=*)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(curl -fsS https://design.life-cockpit.de/*)"
    ],
    "deny": [
      "Bash(npm publish *)",
      "Bash(npm stage publish *)",
      "Bash(npm stage approve *)",
      "Bash(npm unpublish *)",
      "Bash(npm deprecate *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --tags *)",
      "Bash(git push --delete *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(npx cdk *)",
      "Bash(cdk *)",
      "Bash(aws *)"
    ]
  }
}
